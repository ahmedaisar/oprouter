# Server-only OpenRouter API key. Never prefix this with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and publishable/anon key (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional positive integer applied per authenticated user in each UTC month.
# Leave blank to disable monthly token quota enforcement.
DEFAULT_MONTHLY_TOKEN_LIMIT=
